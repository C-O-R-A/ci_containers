{
  "name": "ROS2 Jazzy",
  "image": "osrf/ros:jazzy-desktop-full",
  "features": {
    "ghcr.io/devcontainers/features/desktop-lite:1": {}
  },
  "containerEnv": {
    "ROS_DISTRO": "jazzy"
  },
  "postCreateCommand": "bash cora_ros2/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-vscode.cpptools",
        "ms-iot.vscode-ros"
      ]
    }
  }
}
